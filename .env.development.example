APP_ENV=development
SERVICE_MODE=all

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-admin-password
READ_ADMIN_USERNAME=viewer
READ_ADMIN_PASSWORD=change-this-local-read-password
ADMIN_SESSION_SECRET=change-this-local-session-secret

# MariaDB
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=
MARIADB_CONNECTION_LIMIT=10
MARIADB_AUTO_SCHEMA=true

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_CHANNEL_ID=0
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=10
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=10

# Partner integrations
INTEGRATION_API_TOKEN=change-this-local-integration-token

# Email
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
